{
  "name": "@morphixai/mxenv-cli",
  "version": "0.17.0",
  "description": "L3 management face for mxenv — machine-level extras like shell-init.",
  "license": "MIT",
  "author": "MorphixAI <dev@morphixai.com>",
  "homepage": "https://github.com/Morphicai/morphix-env#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morphicai/morphix-env.git",
    "directory": "packages/mxenv-cli"
  },
  "bugs": {
    "url": "https://github.com/Morphicai/morphix-env/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-panel-ui.mjs && tsup",
    "test": "pnpm --filter @morphixai/mxenv-core build && pnpm --filter @morphixai/mxenv build && pnpm build && vitest run",
    "typecheck": "pnpm --filter @morphixai/mxenv-core build && node scripts/build-panel-ui.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.panel-ui.json",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "esbuild": "^0.27.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.1"
  },
  "bin": {
    "mxenv": "./dist/cli.js",
    "mxenv-cli": "./dist/cli.js"
  },
  "dependencies": {
    "@morphixai/mxenv-core": "^0.17.0"
  }
}
