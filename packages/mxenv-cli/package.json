{
  "name": "@morphixai/mxenv-cli",
  "version": "0.12.0",
  "description": "L3 management face for mxenv \u2014 machine-level extras like shell-init.",
  "license": "MIT",
  "author": "MorphixAI <dev@morphixai.com>",
  "homepage": "https://github.com/Morphicai/morphix-env#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morphicai/morphix-env.git",
    "directory": "packages/mxenv-cli"
  },
  "bugs": {
    "url": "https://github.com/Morphicai/morphix-env/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "pnpm --filter @morphixai/mxenv-core build && pnpm --filter @morphixai/mxenv build && pnpm build && vitest run",
    "typecheck": "pnpm --filter @morphixai/mxenv-core build && tsc --noEmit",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.1"
  },
  "bin": {
    "mxenv": "./dist/cli.js",
    "mx-env": "./dist/cli.js",
    "morphix-env": "./dist/cli.js",
    "mxenv-cli": "./dist/cli.js"
  },
  "dependencies": {
    "@morphixai/mxenv-core": "^0.12.0"
  }
}
