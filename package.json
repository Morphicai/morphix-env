{
  "name": "morphix-env",
  "version": "0.13.0",
  "description": "Deprecated forwarding shim for mxenv — install `@morphixai/mxenv` (project) or `@morphixai/mxenv-cli` (global management) instead; this package forwards the legacy `mx-env`/`morphix-env` bins and re-exports the @morphixai/mxenv-core SDK facade.",
  "author": "MorphixAI <dev@morphixai.com>",
  "homepage": "https://github.com/Morphicai/morphix-env#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morphicai/morphix-env.git"
  },
  "bugs": {
    "url": "https://github.com/Morphicai/morphix-env/issues"
  },
  "bin": {
    "morphix-env": "./bin/forward-cli.js",
    "mx-env": "./bin/forward-cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./bin/forward-cli.d.ts",
      "default": "./bin/forward-cli.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --filter @morphixai/mxenv-core build && tsup src/index.ts --format cjs --dts --clean --external keytar",
    "dev": "tsup src/index.ts --format cjs --watch",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node scripts/prepublish-guard.mjs && pnpm test"
  },
  "files": [
    "bin",
    "dist",
    "docs/logo.svg",
    "SECURITY.md"
  ],
  "keywords": [
    "env",
    "dotenv",
    "environment-variables",
    "cross-env",
    "infisical",
    "doppler",
    "keychain",
    "secrets",
    "secret-management",
    "agent",
    "agent-skills",
    "runtime-env",
    "nextjs",
    "vite",
    "docker",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.30.0",
    "cjs-module-lexer": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@morphixai/mxenv": "^0.12.0",
    "@morphixai/mxenv-core": "^0.12.0"
  }
}
