{
  "name": "morphix-env",
  "version": "0.7.0-beta.1",
  "description": "Secret composition CLI — Infisical, Doppler, macOS Keychain, dotenvx, and local files stay value owners; composes them into one value-safe child environment and ships a built-in Agent Skill (mx-env skill install).",
  "author": "MorphixAI <dev@morphixai.com>",
  "homepage": "https://github.com/Morphicai/morphix-env#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morphicai/morphix-env.git"
  },
  "bugs": {
    "url": "https://github.com/Morphicai/morphix-env/issues"
  },
  "bin": {
    "morphix-env": "./dist/cli.js",
    "mx-env": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build-editor-ui.mjs && tsup src/cli.ts --format cjs --dts --clean --external keytar && node scripts/copy-skill.mjs",
    "dev": "node scripts/build-editor-ui.mjs && tsup src/cli.ts --format cjs --watch",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "env",
    "dotenv",
    "environment-variables",
    "cross-env",
    "infisical",
    "doppler",
    "keychain",
    "secrets",
    "secret-management",
    "agent",
    "agent-skills",
    "runtime-env",
    "nextjs",
    "vite",
    "docker",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.30.0",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.3.1"
  },
  "optionalDependencies": {
    "keytar": "7.9.0"
  }
}
